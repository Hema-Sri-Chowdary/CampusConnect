{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "backend/api/index.js"
    },
    {
      "source": "/health",
      "destination": "backend/api/index.js"
    },
    {
      "source": "/((?!api|health|assets|favicon.ico).*)" ,
      "destination": "/index.html"
    }
  ]
}
